PORT=4000
HOST=127.0.0.1

# Create this key in the Resend dashboard. Keep it only in your local .env or host secrets.
RESEND_API_KEY=

# Resend's development sender. Use a sender on your verified domain for production.
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=

# Set to true only while intentionally running `pnpm run test:email`.
EMAIL_TEST_MODE=false

# Optional: only enable TRUST_PROXY=true behind exactly one trusted reverse proxy.
TRUST_PROXY=false

# Optional: enquiry persistence. Email delivery does not require MongoDB.
MONGODB_URI=
